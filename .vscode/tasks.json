{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ng serve (web)",
      "type": "shell",
      "command": "npm run start -w @dev-assistant/web",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "source": "ts",
        "applyTo": "closedDocuments",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^(ERROR|Error): (.*)$",
          "severity": 1,
          "message": 2
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Building\\.\\.\\.",
          "endsPattern": "Application bundle generation complete|Watch mode enabled"
        }
      }
    }
  ]
}
