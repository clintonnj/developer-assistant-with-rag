{
  "name": "developer-assistant-with-rag-support",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run start:dev -w @dev-assistant/api\" \"npm run start -w @dev-assistant/web\"",
    "start:api": "npm run start:dev -w @dev-assistant/api",
    "start:web": "npm run start -w @dev-assistant/web",
    "build:web": "npm run build -w @dev-assistant/web",
    "typecheck": "npm run typecheck -w @dev-assistant/api && npm run typecheck -w @dev-assistant/web"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "esbuild@0.28.2": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
